# CampusConnect - AI Campus Operations Agent
# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Application Environment
NODE_ENV=development
PORT=3000

# Staff Verification Code — NEVER expose this in frontend code
# Staff members must enter this during registration; validated server-side only.
STAFF_VERIFICATION_CODE=CAMPUS_STAFF_2026
